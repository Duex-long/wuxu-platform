COMPOSE_PROJECT_NAME=wuxu-production
WEB_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

WEB_IMAGE=ghcr.io/duex-long/wuxu-web
WEB_IMAGE_TAG=latest
SERVER_IMAGE=ghcr.io/duex-long/wuxu-server
SERVER_IMAGE_TAG=latest

# 可选：与 compose.source-build.yaml 一起使用，从 Git 拉取源码后在部署机本地构建。
SOURCE_GIT_URL=https://github.com/Duex-long/wuxu-platform.git
SOURCE_GIT_REF=main
SOURCE_IMAGE_TAG=local
SOURCE_WEB_IMAGE=wuxu/web-source
SOURCE_SERVER_IMAGE=wuxu/server-source

MYSQL_DATABASE=wuxu
MYSQL_USER=wuxu
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_SYNCHRONIZE=true

MONGODB_DATABASE=wuxu

S3_REGION=us-east-1
S3_BUCKET=wuxu-items
S3_ACCESS_KEY=replace-with-a-random-access-key
S3_SECRET_KEY=replace-with-a-strong-secret-key

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h

# 首次启动时可设为 true 创建初始账号；账号创建后改回 false。
SEED_INITIAL_USERS=true
INITIAL_USER_EMAIL=user@example.com
INITIAL_USER_PASSWORD=replace-with-a-strong-user-password
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
