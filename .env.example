# Docker Compose project
COMPOSE_PROJECT_NAME=wuxu

# MySQL 8.4
MYSQL_DATABASE=wuxu
MYSQL_USER=wuxu
MYSQL_PASSWORD=wuxu_dev_password
MYSQL_ROOT_PASSWORD=wuxu_root_password

# Host directories for database persistence. Relative paths use the Compose file directory.
MYSQL_DATA_PATH=./data/mysql
MONGODB_DATA_PATH=./data/mongodb
MONGODB_CONFIG_PATH=./data/mongodb-config

# API
API_PORT=3100
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Seeded development accounts
SEED_DEV_USERS=true
DEV_USER_EMAIL=user@wuxu.local
DEV_USER_PASSWORD=wuxu-user-123456
DEV_ADMIN_EMAIL=admin@wuxu.local
DEV_ADMIN_PASSWORD=wuxu-admin-123456

# Web ports
USER_WEB_PORT=5173
ADMIN_WEB_PORT=5174

