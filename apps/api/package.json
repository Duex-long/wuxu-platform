{
  "name": "@wuxu/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @wuxu/shared-types build",
    "build": "nest build",
    "prestart:dev": "pnpm --filter @wuxu/shared-types build",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/mongoose": "11.0.3",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.1",
    "@nestjs/typeorm": "11.0.0",
    "@wuxu/shared-types": "workspace:*",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "mongoose": "8.19.1",
    "multer": "2.4.0",
    "mysql2": "3.15.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@types/express": "5.0.3",
    "@types/multer": "2.3.0",
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  }
}
