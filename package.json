{
  "name": "wuxu-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Wuxu personal inventory management platform monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.20.0 <25",
    "pnpm": "10.18.3"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @wuxu/api start:dev",
    "dev:user": "pnpm --filter @wuxu/user-web dev",
    "dev:admin": "pnpm --filter @wuxu/admin-web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm --filter @wuxu/shared-types build && pnpm -r --if-present typecheck",
    "docker:verify": "docker build --target verification -f Dockerfile.dev .",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "compose:production:config": "docker compose --env-file .env.production -f compose.production.yaml config",
    "compose:production:pull": "docker compose --env-file .env.production -f compose.production.yaml pull",
    "compose:production:up": "docker compose --env-file .env.production -f compose.production.yaml up -d --pull always",
    "compose:production:down": "docker compose --env-file .env.production -f compose.production.yaml down"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

